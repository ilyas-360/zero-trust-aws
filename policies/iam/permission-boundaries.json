{
  "_comment": "WorkloadPermissionBoundary — attached to the project's example security-read role.",
  "_purpose": "Caps effective permissions for this specific role. Creating this managed policy does not automatically enforce it on every role in the workload account.",
  "_threat_closed": "Limits IAM privilege escalation and changes to centralized security controls for the bounded role.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSecurityReadEvidence",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:LookupEvents",
        "config:Describe*",
        "config:Get*",
        "config:List*",
        "ec2:Describe*",
        "guardduty:Get*",
        "guardduty:List*",
        "securityhub:Describe*",
        "securityhub:Get*",
        "securityhub:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIAMPrivilegeEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:Attach*",
        "iam:CreateAccessKey",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:CreateRole",
        "iam:CreateUser",
        "iam:Delete*",
        "iam:Detach*",
        "iam:PassRole",
        "iam:Put*",
        "iam:SetDefaultPolicyVersion",
        "iam:Update*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOrganizationAndSecurityControlChanges",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "cloudtrail:DeleteTrail",
        "cloudtrail:StopLogging",
        "cloudtrail:UpdateTrail",
        "config:DeleteConfigurationRecorder",
        "config:StopConfigurationRecorder",
        "guardduty:DeleteDetector",
        "guardduty:DisassociateFromMasterAccount",
        "guardduty:StopMonitoringMembers",
        "securityhub:Delete*",
        "securityhub:DisableSecurityHub"
      ],
      "Resource": "*"
    }
  ]
}
